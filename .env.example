# --- Flask config ---
FLASK_DEBUG=True
FLASK_APP=application.py

# --- Logger config ---
LOGGER_LEVEL=DEBUG
LOGGER_VERBOSE=TRUE

# --- JWT config ---
# Secret key used to sign JWT tokens. Use a long random string in production.
JWT_SECRET_KEY=change-me-in-production

# --- CORS / runtime ---
# Comma-separated list of allowed frontend origins (no "*" in production — startup will fail).
# Frontend dev server runs on 5173 (Vite strictPort=true).
ALLOWED_ORIGINS=http://localhost:5173
PORT=5000
TIMEZONE=UTC

# --- AWS S3 config ---
# En producción (EC2 con IAM Role): solo necesitás AWS_REGION y AWS_S3_BUCKET
# En dev con credenciales reales: completar las cuatro variables
# En dev con LocalStack: activar USE_LOCALSTACK=true (no necesitás credenciales reales)
AWS_REGION=us-east-1
AWS_S3_BUCKET=abricot-bucket-static-resources
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LocalStack (dev local sin credenciales AWS) ---
USE_LOCALSTACK=false
# S3 API when using docker compose service `abricot-localstack` (published port 4566)
LOCALSTACK_ENDPOINT=http://localhost:4566

# --- PostgreSQL config ---
# Docker Compose service name: abricot-db (see docker-compose.yml).
# Start the DB before migrations or Flask: docker compose up -d
# for more details see https://hub.docker.com/_/postgres#environment-variables
#
# When Flask runs on your host or in WSL, use localhost and the published port:
POSTGRES_DB=dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=example
#
# When the API runs inside Docker on the same Compose network, set:
# POSTGRES_HOST=abricot-db
